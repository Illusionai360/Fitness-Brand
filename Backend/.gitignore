# ===================================
# Node.js / Express / MERN .gitignore
# ===================================

# Node modules
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Build output
dist/
build/
.next/
out/
coverage/
.cache/

# IDE / Editor folders
.vscode/
.idea/
*.swp

# Temporary files
*.tmp
*.temp
*.bak

# Miscellaneous
package-lock.json
yarn.lock
